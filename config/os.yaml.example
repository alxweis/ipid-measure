# --- GENERAL -----------------------------------------------------------------

zmap: tcp-80_YYYY-MM-DD_HH-MM-SS

modules:
  ssh: true   # SSH banner
  smb: true   # NTLM Native OS field
  http: true  # HTTP Server header on port 80
  https: true # HTTP Server header on port 443
  snmp: true  # SNMP sysDescr.0 (in-process UDP probe, no external tool)
  dns_chaos: true  # in-process version.bind CHAOS TXT probe

# --- SPEED -------------------------------------------------------------------

zgrab2_senders: 5000
dns_chaos_workers: 1000
snmp_workers: 3000

# --- ADDITIONAL --------------------------------------------------------------

connect_timeout: 1s
read_timeout: 1s
snmp_timeout: 1s

snmp_community: public

log_to_file: false

# --- MEMORY ------------------------------------------------------------------

# go_memory_limit: 384M

# --- UPLOAD ------------------------------------------------------------------

upload:
  enable: true
  s3_destination: s3://bucket/prefix/
  delete_local: false
